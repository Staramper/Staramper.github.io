---
import Layout from '../layouts/Layout.astro';
import Background3D from '../components/Background3D.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Pipeline from '../components/Pipeline.astro';
import { projects, services, stack } from '../data/projects';

const GITHUB = 'https://github.com/Staramper';
const AVATAR = 'https://avatars.githubusercontent.com/u/136607801?v=4';

const aiProjects = projects.filter((p) => p.category === 'ia');
const devProjects = projects.filter((p) => p.category === 'dev');

const rotating = ['agentes de IA', 'servidores MCP', 'flujos con n8n', 'integraciones de APIs'];
---

<Layout>
  <Background3D />
  <Nav />

  <main>
    <!-- HERO -->
    <section class="relative flex min-h-svh items-center px-4">
      <div class="mx-auto w-full max-w-5xl">
        <p
          data-reveal
          class="glass inline-flex items-center gap-2 rounded-full px-3 py-1.5 font-mono text-xs text-zinc-300"
        >
          <span class="size-2 animate-pulse rounded-full bg-emerald-400"></span>
          Especialista en Automatización e IA
        </p>
        <h1
          data-reveal
          style="--delay:80ms"
          class="mt-6 text-5xl leading-[0.95] font-bold tracking-tight text-white sm:text-7xl md:text-8xl"
        >
          Abraham<br /><span class="text-gradient">De La Hoya</span>
        </h1>
        <p data-reveal style="--delay:160ms" class="mt-6 max-w-xl text-lg text-zinc-400 sm:text-xl">
          Pongo a trabajar a la IA dentro de los procesos reales de un negocio. Construyo
          <span
            id="rotating"
            data-words={JSON.stringify(rotating)}
            class="inline-block font-mono text-base text-accent transition-opacity duration-300 sm:text-lg"
            >{rotating[0]}</span
          >.
        </p>
        <div data-reveal style="--delay:240ms" class="mt-10 flex flex-wrap gap-3">
          <a
            href="#que-hago"
            class="rounded-xl bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:shadow-[0_10px_40px_-10px_var(--color-accent-2)]"
          >
            Qué automatizo
          </a>
          <a
            href="#proyectos"
            class="glass rounded-xl px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5"
          >
            Ver proyectos
          </a>
        </div>
      </div>
      <a
        href="#sobre-mi"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-xs tracking-widest text-zinc-500 uppercase"
      >
        <span class="block animate-bounce">scroll ↓</span>
      </a>
    </section>

    <!-- SOBRE MÍ -->
    <section id="sobre-mi" class="px-4 py-32">
      <div class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[auto_1fr]">
        <div data-reveal class="relative mx-auto size-48 md:size-60">
          <div
            class="absolute -inset-1 animate-spin rounded-full bg-[conic-gradient(var(--color-accent),var(--color-accent-2),var(--color-accent-3),var(--color-accent))] [animation-duration:8s]"
          >
          </div>
          <img
            src={AVATAR}
            alt="Abraham De La Hoya"
            width="240"
            height="240"
            loading="lazy"
            class="relative size-full rounded-full border-4 border-ink object-cover"
          />
        </div>
        <div data-reveal style="--delay:120ms" class="glass rounded-3xl p-8">
          <h2 class="font-mono text-sm text-accent">01 · Sobre mí</h2>
          <p class="mt-4 text-2xl leading-snug font-medium text-white sm:text-3xl">
            Hoy trabajo como <span class="text-gradient">especialista en automatización e IA</span>: conecto modelos
            de lenguaje, APIs y flujos para que el trabajo repetitivo se haga solo.
          </p>
          <p class="mt-5 text-zinc-400">
            Vengo del desarrollo full-stack (web, móvil y backend), y eso es lo que me permite llevar la IA de la demo
            a producción: entiendo los sistemas que hay que conectar, no sólo el modelo. Fuera del código diseño en
            Blender, imprimo en 3D y edito video.
          </p>
          <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-white/10 pt-6 text-center">
            <div>
              <dt class="text-xs text-zinc-500">Enfoque</dt>
              <dd class="text-gradient text-xl font-bold sm:text-2xl">IA + Automatización</dd>
            </div>
            <div>
              <dt class="text-xs text-zinc-500">Base</dt>
              <dd class="text-gradient text-xl font-bold sm:text-2xl">Full-stack</dd>
            </div>
            <div>
              <dt class="text-xs text-zinc-500">Ubicación</dt>
              <dd class="text-gradient text-xl font-bold sm:text-2xl">Dgo, MX</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- QUÉ HAGO -->
    <section id="que-hago" class="px-4 py-32">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="mb-12">
          <h2 class="font-mono text-sm text-accent">02 · Qué hago</h2>
          <p class="mt-3 max-w-2xl text-4xl font-bold text-white sm:text-5xl">
            IA que <span class="text-gradient">hace cosas</span>, no sólo responde
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {services.map((s, i) => <ServiceCard {...s} index={i} />)}
        </div>
        <Pipeline />
      </div>
    </section>

    <!-- PROYECTOS -->
    <section id="proyectos" class="px-4 py-32">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="mb-12 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="font-mono text-sm text-accent">03 · Proyectos</h2>
            <p class="mt-3 text-4xl font-bold text-white sm:text-5xl">Cosas que he construido</p>
          </div>
          <a href={`${GITHUB}?tab=repositories`} target="_blank" rel="noopener" class="text-sm text-zinc-400 hover:text-white">
            Todos los repos ↗
          </a>
        </div>

        <h3 data-reveal class="mb-5 font-mono text-xs tracking-widest text-zinc-500 uppercase">IA, automatización e integraciones</h3>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {aiProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>

        <h3 data-reveal class="mt-14 mb-5 font-mono text-xs tracking-widest text-zinc-500 uppercase">Desarrollo full-stack</h3>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {devProjects.map((project, index) => <ProjectCard project={project} index={aiProjects.length + index} />)}
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section id="stack" class="px-4 py-32">
      <div class="mx-auto max-w-5xl">
        <div data-reveal class="mb-12">
          <h2 class="font-mono text-sm text-accent">04 · Stack</h2>
          <p class="mt-3 text-4xl font-bold text-white sm:text-5xl">Herramientas favoritas</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {
            stack.map((s, i) => (
              <div data-reveal style={`--delay:${i * 90}ms`} class="glass rounded-2xl p-6">
                <h3 class="font-mono text-xs tracking-widest text-zinc-500 uppercase">{s.group}</h3>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {s.items.map((item) => (
                    <li class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-zinc-200 transition hover:border-accent/50 hover:text-white">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="flex min-h-[80svh] items-center px-4 py-32">
      <div data-reveal class="mx-auto max-w-3xl text-center">
        <h2 class="font-mono text-sm text-accent">05 · Contacto</h2>
        <p class="mt-4 text-5xl font-bold tracking-tight text-white sm:text-7xl">
          ¿Qué <span class="text-gradient">automatizamos</span>?
        </p>
        <p class="mx-auto mt-6 max-w-lg text-lg text-zinc-400">
          Si tienes un proceso manual, repetitivo o que depende de copiar y pegar entre sistemas, platiquemos.
        </p>
        <a
          href={GITHUB}
          target="_blank"
          rel="noopener"
          class="mt-10 inline-block rounded-xl bg-white px-6 py-3.5 font-semibold text-ink transition hover:-translate-y-0.5 hover:shadow-[0_10px_40px_-10px_var(--color-accent)]"
        >
          Escríbeme en GitHub ↗
        </a>
      </div>
    </section>
  </main>

  <footer class="px-4 pb-10 text-center font-mono text-xs text-zinc-600">
    © {new Date().getFullYear()} Abraham De La Hoya · Hecho con Astro, Tailwind y Three.js
  </footer>
</Layout>

<script>
  // Aparición al hacer scroll
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    // Lo que ya está en pantalla se revela sin esperar al observer.
    if (el.getBoundingClientRect().top < window.innerHeight) {
      requestAnimationFrame(() => el.classList.add('is-visible'));
    } else {
      io.observe(el);
    }
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Palabra rotativa del hero
  const rotating = document.getElementById('rotating');
  if (rotating && !reducedMotion) {
    const words: string[] = JSON.parse(rotating.dataset.words ?? '[]');
    let i = 0;
    setInterval(() => {
      rotating.style.opacity = '0';
      setTimeout(() => {
        i = (i + 1) % words.length;
        rotating.textContent = words[i];
        rotating.style.opacity = '1';
      }, 300);
    }, 2600);
  }

  // Inclinación 3D de las tarjetas
  if (!reducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--ry', `${(x - 0.5) * 10}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 10}deg`);
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
